{
  "name": "debates-checados",
  "version": "0.1.0",
  "private": true,
  "description": "Public archive of fact-checks of the 2026 presidential runoff debates",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/debateschecados/debateschecados.github.io",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "ingest": "node src/ingest.ts",
    "build": "node src/site/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:unit": "vitest run --project unit",
    "check:labels": "node src/check-labels.ts",
    "claims:input": "node src/claims/blind.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "robots-parser": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
